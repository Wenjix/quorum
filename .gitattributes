# quorum.skill is built with `git archive` (npm run build:skill), which applies
# line-ending conversion from these attributes. The packaged files must stay LF
# on every platform — CRLF in fetch_findings.sh breaks bash on macOS/Linux.
SKILL.md text eol=lf
scripts/** text eol=lf
references/** text eol=lf
# Keep the python test suite and bytecode caches out of the git archive zip.
scripts/tests export-ignore
scripts/tests/** export-ignore
scripts/**/__pycache__/** export-ignore
